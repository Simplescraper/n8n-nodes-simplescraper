{
	"name": "n8n-nodes-simplescraper",
	"version": "0.1.3",
	"description": "n8n community node for Simplescraper — web scraping API",
	"license": "MIT",
	"homepage": "https://simplescraper.io",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"simplescraper",
		"scraping",
		"web-scraping",
		"automation"
	],
	"author": {
		"name": "simplescraperapp",
		"email": "mike@simplescraper.io"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Simplescraper/n8n-nodes-simplescraper.git"
	},
	"publishConfig": {
		"provenance": true
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/SimpleScraperApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/SimpleScraper/SimpleScraper.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.29.0",
		"prettier": "3.8.3",
		"release-it": "20.0.1",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
